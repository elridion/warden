<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>Warden</AssemblyName>
    <RootNamespace>Warden</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.3.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Unity/BepInEx reference mismatched netstandard versions; harmless at runtime -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- Lets Jotunn generate publicized Valheim assemblies on first build -->
    <ExecutePrebuild>true</ExecutePrebuild>
    <!-- Override if Valheim lives elsewhere: dotnet build -p:VALHEIM_INSTALL="D:\...\Valheim" -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.30.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Update="@(Reference)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\models\offering_cup\greek_cup.obj" LogicalName="Warden.offering_cup.obj" />
    <EmbeddedResource Include="assets\textures\banner_runed_hide.png" LogicalName="Warden.banner_runed_hide.png" />
    <EmbeddedResource Include="assets\textures\banner_runed_hide_n.png" LogicalName="Warden.banner_runed_hide_n.png" />
  </ItemGroup>

  <!-- Deploy into the Gale mod manager profile when present, else the game's own BepInEx.
       Override with -p:DeployBepInEx="<path to BepInEx folder>". -->
  <PropertyGroup>
    <GaleProfile Condition="'$(GaleProfile)' == ''">Default</GaleProfile>
    <GaleBepInEx>$(APPDATA)\com.kesomannen.gale\valheim\profiles\$(GaleProfile)\BepInEx</GaleBepInEx>
    <DeployBepInEx Condition="'$(DeployBepInEx)' == '' And Exists('$(GaleBepInEx)')">$(GaleBepInEx)</DeployBepInEx>
    <DeployBepInEx Condition="'$(DeployBepInEx)' == ''">$(BEPINEX_PATH)</DeployBepInEx>
  </PropertyGroup>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(DeployBepInEx)')">
    <MakeDir Directories="$(DeployBepInEx)\plugins\Warden" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DeployBepInEx)\plugins\Warden" />
    <Message Importance="High" Text="Deployed $(TargetFileName) to $(DeployBepInEx)\plugins\Warden" />
  </Target>

  <!-- Thunderstore/Hexium package: dotnet build -c Release -t:Package -->
  <PropertyGroup>
    <PackageDescription>Buildable ward stone that blocks creature spawns inside its radius.</PackageDescription>
    <PackageWebsite>https://github.com/elridion/warden</PackageWebsite>
    <PackageDependencies>"ValheimModding-Jotunn-2.30.2"</PackageDependencies>
    <PackageStagingDir>$(BaseIntermediateOutputPath)package\</PackageStagingDir>
    <PackageOutputDir>$(MSBuildProjectDirectory)\dist\</PackageOutputDir>
  </PropertyGroup>

  <Target Name="Package" DependsOnTargets="Build">
    <RemoveDir Directories="$(PackageStagingDir)" />
    <MakeDir Directories="$(PackageStagingDir);$(PackageOutputDir)" />
    <Copy SourceFiles="$(TargetPath);package\icon.png;README.md;CHANGELOG.md" DestinationFolder="$(PackageStagingDir)" />
    <WriteLinesToFile File="$(PackageStagingDir)manifest.json" Overwrite="true" Lines="{;  &quot;name&quot;: &quot;$(AssemblyName)&quot;,;  &quot;description&quot;: &quot;$(PackageDescription)&quot;,;  &quot;version_number&quot;: &quot;$(Version)&quot;,;  &quot;website_url&quot;: &quot;$(PackageWebsite)&quot;,;  &quot;dependencies&quot;: [$(PackageDependencies)];}" />
    <Delete Files="$(PackageOutputDir)$(AssemblyName)-$(Version).zip" />
    <ZipDirectory SourceDirectory="$(PackageStagingDir)" DestinationFile="$(PackageOutputDir)$(AssemblyName)-$(Version).zip" />
    <Message Importance="High" Text="Packaged $(PackageOutputDir)$(AssemblyName)-$(Version).zip" />
  </Target>

</Project>
